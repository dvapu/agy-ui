{
  "name": "agy-ui",
  "productName": "Antigravitinho",
  "version": "1.0.0",
  "private": true,
  "description": "Live ASCII wallpaper + Honu mascot injected straight into the real Antigravity window. No separate chat app, no database access.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test test/*.test.js",
    "check": "node test/syntax.test.js",
    "do-cong": "node tools/kiem-tra-cong.js"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "author": {
    "name": "dvapu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dvapu/agy-ui.git"
  },
  "homepage": "https://github.com/dvapu/agy-ui#readme",
  "keywords": [
    "antigravity",
    "agy",
    "ascii",
    "wallpaper",
    "electron",
    "mascot"
  ],
  "build": {
    "appId": "com.agyui.antigravitinho",
    "productName": "Antigravitinho",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Antigravitinho",
      "artifactName": "Antigravitinho-Setup.exe"
    }
  }
}

{
  "name": "antigravitinho",
  "productName": "Antigravitinho",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop App cho Antigravity (AGY) — trò chuyện AI với hình nền ASCII sống động",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "shortcut": "powershell -ExecutionPolicy Bypass -File tools/tao-shortcut.ps1",
    "shortcut:go": "powershell -ExecutionPolicy Bypass -File tools/tao-shortcut.ps1 -Go",
    "test": "node --test test/syntax.test.js tools/test-chan-dialog.mjs",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "author": {
    "name": "Antigravity User"
  },
  "build": {
    "appId": "com.antigravitinho.app",
    "productName": "Antigravitinho",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/khay-16.png",
      "assets/khay-32.png",
      "assets/agy-a.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Antigravitinho",
      "artifactName": "Antigravitinho-Setup.exe"
    }
  }
}
